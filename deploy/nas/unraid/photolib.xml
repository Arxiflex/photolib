<?xml version="1.0"?>
<!-- Unraid Community Applications template: photolibd alone, beside a PostgreSQL 16+ container of your choice. -->
<Container version="2">
  <Name>Photolib</Name>
  <Repository>ghcr.io/arxiflex/photolib:0.1.0</Repository>
  <Registry>https://github.com/Arxiflex/photolib/pkgs/container/photolib</Registry>
  <Network>bridge</Network>
  <Support>https://github.com/Arxiflex/photolib/issues</Support>
  <Project>https://github.com/Arxiflex/photolib</Project>
  <Overview>Your own photo and video library: back up, browse and share photos and videos from every device.</Overview>
  <Category>MediaServer:Photos</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/Arxiflex/photolib/main/app/web/icons/Icon-512.png</Icon>
  <ExtraParams>--user 99:100 --read-only --tmpfs /tmp</ExtraParams>
  <Config Name="Web app and API" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always" Required="true"/>
  <Config Name="Libraries" Target="/data" Default="/mnt/user/appdata/photolib/data" Mode="rw" Type="Path" Display="always" Required="true"/>
  <Config Name="Sign-in key (back it up apart from the libraries)" Target="/keys" Default="/mnt/user/appdata/photolib/keys" Mode="rw" Type="Path" Display="always" Required="true"/>
  <Config Name="Database URL" Target="PHOTOLIB_DATABASE__URL" Default="" Description="postgres://user:password@host/photolib of PostgreSQL 16 or newer" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Public URL" Target="PHOTOLIB_PUBLIC_URL" Default="" Description="The address apps reach Photolib at, such as http://tower.local:8080" Type="Variable" Display="always" Required="false"/>
  <Config Name="OPAQUE key file" Target="PHOTOLIB_OPAQUE_KEY_FILE" Default="/keys/opaque.key" Type="Variable" Display="advanced" Required="true"/>
</Container>
