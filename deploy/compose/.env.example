# The settings of compose.yaml. setup.sh copies this file to .env with your domain, user and a new password.
# The name the server answers to: its DNS record points at this host, and ports 80 and 443 reach it.
PHOTOLIB_DOMAIN=photos.example.com
# Empty serves Photolib at https://<domain>/; /photos serves it at https://<domain>/photos/.
PHOTOLIB_BASE_PATH=
# The release channel (stable, beta or nightly) or a version.
PHOTOLIB_VERSION=stable
# Where the libraries and photolibd's state live.
PHOTOLIB_DATA=./data
# The user and group that run every container and own its files.
PUID=1000
PGID=1000
POSTGRES_PASSWORD=change-me
# The containers' network, whose forwarded headers photolibd believes; change it if it collides with another network.
PHOTOLIB_SUBNET=172.30.108.0/24
