<?xml version="1.0" encoding="utf-8"?>
<!-- The MSIX package of the Windows app (tools/package.sh msix, ADR-0154); VERSION is the pubspec's. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">
  <Identity Name="org.photolib.photolib" Publisher="CN=Photolib" Version="VERSION" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Photolib</DisplayName>
    <PublisherDisplayName>Photolib</PublisherDisplayName>
    <Logo>logo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Photolib" Executable="photolib.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Photolib" Description="Photolib" BackgroundColor="transparent"
        Square150x150Logo="logo.png" Square44x44Logo="logo.png" />
      <Extensions>
        <!-- Open with Photolib: Windows starts the app with the file's path, as Linux does (main.dart). -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="media">
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.jxl</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.cr2</uap:FileType>
              <uap:FileType>.cr3</uap:FileType>
              <uap:FileType>.nef</uap:FileType>
              <uap:FileType>.arw</uap:FileType>
              <uap:FileType>.orf</uap:FileType>
              <uap:FileType>.rw2</uap:FileType>
              <uap:FileType>.raf</uap:FileType>
              <uap:FileType>.srw</uap:FileType>
              <uap:FileType>.pef</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- Password setup links that photolibd's page hands the app (ADR-0243), as its first argument. -->
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="photolib" Parameters="&quot;%1&quot;" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
