# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{kt,kts,swift}]
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.md]
max_line_length = 120

[testdata/corpus/files/**]
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab

# Xcode rewrites these files with tabs on every edit.
[*.{pbxproj,plist,entitlements,xcsettings}]
indent_style = tab

[*.go]
indent_style = tab
