# The LGPL libmpv and FFmpeg tools/video/libmpv.sh builds (ADR-0229), taken only by the SHA-256 libmpv.json pins:
# from app/build/libmpv/, else downloaded from its release, and extracted where media_kit_video looks for them
# (libmpv/, ANGLE/). Sets MEDIA_KIT_LIBS_AVAILABLE and LIBMPV_BUNDLED_LIBRARIES, the files the app ships beside it.
file(READ "${CMAKE_CURRENT_LIST_DIR}/libmpv.json" LIBMPV_PINS)
string(JSON LIBMPV_ARCHIVE GET "${LIBMPV_PINS}" archive)
string(JSON LIBMPV_SHA256 GET "${LIBMPV_PINS}" sha256)
string(JSON LIBMPV_URL GET "${LIBMPV_PINS}" url)
set(LIBMPV_FILE "${CMAKE_CURRENT_LIST_DIR}/../build/libmpv/${LIBMPV_ARCHIVE}")
if(NOT EXISTS "${LIBMPV_FILE}")
  message(STATUS "libmpv: downloading ${LIBMPV_URL}")
  file(DOWNLOAD "${LIBMPV_URL}" "${LIBMPV_FILE}.part" INACTIVITY_TIMEOUT 60 STATUS LIBMPV_STATUS)
  list(GET LIBMPV_STATUS 0 LIBMPV_CODE)
  if(NOT LIBMPV_CODE EQUAL 0)
    file(REMOVE "${LIBMPV_FILE}.part")
    message(FATAL_ERROR "libmpv: ${LIBMPV_ARCHIVE} is neither in app/build/libmpv nor at ${LIBMPV_URL} "
      "(${LIBMPV_STATUS}); build it with bash tools/video/libmpv.sh")
  endif()
  file(RENAME "${LIBMPV_FILE}.part" "${LIBMPV_FILE}")
endif()
file(SHA256 "${LIBMPV_FILE}" LIBMPV_ACTUAL)
if(NOT LIBMPV_ACTUAL STREQUAL LIBMPV_SHA256)
  message(FATAL_ERROR "libmpv: ${LIBMPV_FILE} has SHA-256 ${LIBMPV_ACTUAL}; libmpv.json pins ${LIBMPV_SHA256}")
endif()
set(LIBMPV_STAMP "${CMAKE_BINARY_DIR}/libmpv/.sha256")
if(NOT EXISTS "${LIBMPV_STAMP}")
  set(LIBMPV_EXTRACTED "")
else()
  file(READ "${LIBMPV_STAMP}" LIBMPV_EXTRACTED)
endif()
if(NOT LIBMPV_EXTRACTED STREQUAL LIBMPV_SHA256)
  file(REMOVE_RECURSE "${CMAKE_BINARY_DIR}/libmpv" "${CMAKE_BINARY_DIR}/ANGLE")
  file(ARCHIVE_EXTRACT INPUT "${LIBMPV_FILE}" DESTINATION "${CMAKE_BINARY_DIR}")
  file(WRITE "${LIBMPV_STAMP}" "${LIBMPV_SHA256}")
endif()
set(MEDIA_KIT_LIBS_AVAILABLE ON)
file(GLOB LIBMPV_BUNDLED_LIBRARIES "${CMAKE_BINARY_DIR}/libmpv/*.dll" "${CMAKE_BINARY_DIR}/libmpv/*.txt")
