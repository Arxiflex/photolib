.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Secrets and key material never belong in the repository. Test vectors are JSON; add a deliberate fixture with
# `git add -f` and say why in the commit.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
/secrets/
